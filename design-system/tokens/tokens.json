{
  "$meta": {
    "name": "Monevo Design Tokens",
    "version": "1.0.0",
    "currency": "BRL",
    "locale": "pt-BR",
    "note": "Mirror of tokens/*.css. Money in minor units (centavos). Negative uses Unicode minus U+2212."
  },
  "color": {
    "white": "#FFFFFF",
    "neutral": {
      "950": "#0C0E12", "900": "#14171C", "800": "#20242C", "700": "#333A45",
      "600": "#4C5460", "500": "#6B7480", "400": "#99A1AD", "300": "#C4C9D1",
      "200": "#E2E5EA", "150": "#EBEEF1", "100": "#F2F4F6", "50": "#F8F9FB"
    },
    "cobalt": {
      "50": "#EEF2FE", "100": "#DCE4FD", "200": "#BBCBFA", "300": "#92ABF3",
      "400": "#5E81E7", "500": "#3A61D9", "600": "#2550CC", "700": "#1E40A6",
      "800": "#1B3585", "900": "#182C69"
    },
    "semantic": {
      "positive": { "fg": "#0E8C57", "bg": "#E3F4EC", "border": "#B6E2CC" },
      "negative": { "fg": "#C92A36", "bg": "#FBE7E8", "border": "#F2C2C5" },
      "alert":    { "fg": "#B5560E", "bg": "#FBEBDD", "border": "#F1D2B2" },
      "info":     { "fg": "#0F73A6", "bg": "#E0F0F8", "border": "#BBDDEC" },
      "ai":       { "fg": "#6D45C7", "bg": "#EEE8FB", "border": "#D6C8F2" }
    },
    "category": {
      "01": "#2E7D6B", "02": "#B5557C", "03": "#7B5BC4", "04": "#2C84A8", "05": "#A56A2E",
      "06": "#4E74A6", "07": "#5E8C36", "08": "#B14A5C", "09": "#6E7888", "10": "#9C57A0"
    },
    "projection": {
      "real":     { "fg": "#14171C", "bg": "#F2F4F6", "border": "1px solid #C4C9D1" },
      "estimado": { "fg": "#4C5460", "bg": "#F8F9FB", "border": "1.5px dotted #99A1AD" },
      "simulado": { "fg": "#1E40A6", "bg": "#EEF2FE", "border": "1.5px dashed #92ABF3" }
    },
    "alias": {
      "bg": "neutral.50", "surface": "white", "surfaceSunken": "neutral.100", "surfaceDark": "neutral.900",
      "scrim": "rgba(12,14,18,0.55)",
      "textPrimary": "neutral.900", "textSecondary": "neutral.600", "textMuted": "neutral.500",
      "textDisabled": "neutral.400", "textOnCobalt": "white",
      "primary": "cobalt.600", "primaryHover": "cobalt.700", "primaryActive": "cobalt.800",
      "onPrimary": "white", "focusRing": "cobalt.400",
      "border": "neutral.200", "borderStrong": "neutral.300", "borderSubtle": "neutral.150"
    },
    "glowCobalt": "radial-gradient(circle, rgba(37,80,204,0.40), transparent 70%)"
  },
  "font": {
    "family": {
      "display": "\"Clash Display\", \"Hanken Grotesk\", system-ui, sans-serif",
      "sans": "\"Hanken Grotesk\", system-ui, -apple-system, sans-serif",
      "mono": "\"IBM Plex Mono\", ui-monospace, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "numeric": { "tabular": "tabular-nums", "moneyDecimalOpacity": 0.45 },
    "scale": {
      "displayLg": { "size": 56, "lh": 1.02, "weight": 600, "tracking": "-0.02em", "family": "display" },
      "displayMd": { "size": 44, "lh": 1.04, "weight": 600, "tracking": "-0.02em", "family": "display" },
      "displaySm": { "size": 34, "lh": 1.08, "weight": 600, "tracking": "-0.015em", "family": "display" },
      "h1": { "size": 28, "lh": 1.14, "weight": 600, "tracking": "-0.015em", "family": "display" },
      "h2": { "size": 22, "lh": 1.20, "weight": 600, "tracking": "-0.01em", "family": "display" },
      "h3": { "size": 18, "lh": 1.28, "weight": 600, "tracking": "-0.005em", "family": "display" },
      "bodyLg": { "size": 17, "lh": 1.55, "weight": 400, "tracking": "0", "family": "sans" },
      "bodyMd": { "size": 15, "lh": 1.55, "weight": 400, "tracking": "0", "family": "sans" },
      "bodySm": { "size": 13, "lh": 1.50, "weight": 400, "tracking": "0", "family": "sans" },
      "label": { "size": 14, "lh": 1.30, "weight": 500, "tracking": "0", "family": "sans" },
      "caption": { "size": 12, "lh": 1.35, "weight": 500, "tracking": "0.005em", "family": "sans" },
      "eyebrow": { "size": 12, "lh": 1.2, "weight": 500, "tracking": "0.14em", "family": "mono", "uppercase": true }
    },
    "money": {
      "hero":  { "size": 48, "lh": 1.0,  "weight": 600, "family": "display", "dimDecimals": true },
      "large": { "size": 30, "lh": 1.05, "weight": 600, "family": "display", "dimDecimals": true },
      "base":  { "size": 17, "lh": 1.3,  "weight": 600, "family": "sans",    "dimDecimals": false },
      "small": { "size": 14, "lh": 1.3,  "weight": 600, "family": "sans",    "dimDecimals": false },
      "delta": { "size": 13, "lh": 1.2,  "weight": 600, "family": "sans",    "dimDecimals": false }
    }
  },
  "space": { "0":0, "1":4, "2":8, "3":12, "4":16, "5":20, "6":24, "8":32, "10":40, "12":48, "16":64, "20":80, "24":96, "tapMin":44 },
  "radius": { "sm":6, "md":10, "lg":14, "xl":20, "2xl":28, "pill":9999, "full":9999 },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(20,23,28,0.05), 0 1px 1px rgba(20,23,28,0.03)",
    "md": "0 6px 16px rgba(20,23,28,0.08), 0 2px 4px rgba(20,23,28,0.04)",
    "lg": "0 16px 40px rgba(20,23,28,0.12), 0 4px 8px rgba(20,23,28,0.05)",
    "xl": "0 28px 64px rgba(20,23,28,0.16)",
    "focus": "0 0 0 3px rgba(37,80,204,0.35)"
  },
  "border": {
    "width": { "default": 1, "strong": 1.5 },
    "solid":  "1px solid #E2E5EA",
    "dotted": "1.5px dotted #99A1AD",
    "dashed": "1.5px dashed #92ABF3"
  },
  "breakpoint": { "sm": 390, "md": 768, "lg": 1024, "xl": 1440 },
  "motion": {
    "duration": { "instant": 80, "fast": 140, "base": 220, "slow": 320 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reducedMotion": "all durations collapse to 0ms"
  }
}
