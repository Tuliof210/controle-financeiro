{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/money/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|shape|color|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, shape, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<Avatar> shape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|variant|size|icon|dot|scope|principal|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, variant, size, icon, dot, scope, principal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|positive|negative|alert|info|ai|cobalt)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'positive' | 'negative' | 'alert' | 'info' | 'ai' | 'cobalt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid|outline)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|fullWidth|loading|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, fullWidth, loading, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|radius|interactive|as|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, radius, interactive, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:flat|elevated|sunken|outline)$/]",
        "message": "<Card> variant must be one of 'flat' | 'elevated' | 'sunken' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Delta'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|percent|money|invert|showArrow|neutralThreshold|size|locale|key|ref|className|style|children)$/]",
        "message": "<Delta> doesn't accept that prop. Declared props: value, percent, money, invert, showArrow, neutralThreshold, size, locale."
      },
      {
        "selector": "JSXOpeningElement[name.name='Delta'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Delta> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|money|value|onChange|placeholder|hint|error|prefix|iconLeft|disabled|required|id|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, type, money, value, onChange, placeholder, hint, error, prefix, iconLeft, disabled, required, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|currency|locale|variant|showPositiveSign|colorBySign|dimDecimals|hideSymbol|hideCents|color|key|ref|className|style|children)$/]",
        "message": "<MoneyDisplay> doesn't accept that prop. Declared props: value, currency, locale, variant, showPositiveSign, colorBySign, dimDecimals, hideSymbol, hideCents, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyDisplay'] > JSXAttribute[name.name='currency'] > Literal[value!=/^(?:BRL|USD|EUR)$/]",
        "message": "<MoneyDisplay> currency must be one of 'BRL' | 'USD' | 'EUR'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyDisplay'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hero|large|base|small|delta)$/]",
        "message": "<MoneyDisplay> variant must be one of 'hero' | 'large' | 'base' | 'small' | 'delta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectionBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|size|showIcon|children|key|ref|className|style|children)$/]",
        "message": "<ProjectionBadge> doesn't accept that prop. Declared props: kind, size, showIcon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectionBadge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:real|estimado|simulado)$/]",
        "message": "<ProjectionBadge> kind must be one of 'real' | 'estimado' | 'simulado'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectionBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<ProjectionBadge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
