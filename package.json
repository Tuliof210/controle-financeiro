{
  "name": "controle-financeiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:postinstall": "prisma generate",
    "db:setup": "npm run db:postinstall && prisma migrate deploy",
    "db:clean": "sqlite3 dev.db \"DELETE FROM Settings; DELETE FROM OfxImport; DELETE FROM ForecastMonth; DELETE FROM Movement; DELETE FROM Forecast; DELETE FROM Goal; DELETE FROM Person;\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && npm run lint:lines",
    "lint:lines": "sh scripts/check-line-cap.sh",
    "lint:fix": "biome check --write .",
    "format": "biome format --write",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@visx/axis": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@jest/globals": "^30.4.1",
    "@storybook/addon-docs": "10.5.3",
    "@storybook/nextjs-vite": "10.5.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "sass": "^1.101.3",
    "storybook": "10.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "^8.1.5"
  }
}
