{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.claude",
      "!.agents",
      "!.impeccable",
      "!.squad"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "performance": "error",
      "security": "error",
      "style": "error",
      "suspicious": "error"
    },
    "domains": {
      "next": "all",
      "react": "all",
      "types": "all",
      "test": "all",
      "solid": "none",
      "qwik": "none",
      "vue": "none",
      "svelte": "none",
      "reactNative": "none",
      "drizzle": "none",
      "tailwind": "none",
      "turborepo": "none",
      "playwright": "none"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.json",
        "**/*.jsonc",
        "**/*.css",
        "**/*.scss",
        "**/*.md",
        "**/*.mdx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "next.config.ts",
        "prisma.config.ts",
        "jest.config.ts",
        ".storybook/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/**/page.tsx", "src/app/**/layout.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 100
              }
            }
          },
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 100
              }
            }
          }
        }
      }
    },
    {
      "includes": ["prisma.config.ts", "src/infra/db/client.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          },
          "correctness": {
            "noProcessGlobal": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/api/ofx/service.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/tests/**"],
      "javascript": {
        "globals": ["jest"]
      },
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
            "noJsxLiterals": "off",
            "useNamingConvention": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "correctness": {
            "noNodejsModules": "off",
            "useUniqueElementIds": "off"
          }
        }
      }
    },
    {
      "includes": [".design-sync/gen-cards.mjs"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/app/_components/DashboardScreen/components/SavingsSection/index.tsx",
        "src/app/api/settings/route.ts",
        "src/app/configuracoes/_components/SettingsScreen/hook.ts",
        "src/app/configuracoes/page.tsx",
        "src/components/AppShell/nav.ts"
      ],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": {
              "level": "error",
              "options": {
                "entropyThreshold": 43
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
