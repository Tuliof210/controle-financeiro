// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id          String       @id @default(cuid())
  name        String       @unique
  color       String
  createdAt   DateTime     @default(now())
  recurrences Recurrence[]
  movements   Movement[]
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  targetCents Int
  createdAt   DateTime @default(now())
}

model Recurrence {
  id         String            @id @default(cuid())
  name       String
  valueCents Int
  type       String
  // "fixed" | "installment", with no Prisma enum — same convention as `type`:
  // a String column guarded by z.enum at the route boundary. The default is
  // what makes every row written before installments existed read back right.
  kind       String            @default("fixed")
  // The price the owner typed for an installment purchase; null on a fixed
  // row, and display-only. Deliberately does NOT reconcile with valueCents:
  // the projection adds valueCents once per active month and never reads this.
  totalCents Int?
  owner      Person            @relation(fields: [ownerId], references: [id])
  ownerId    String
  months     RecurrenceMonth[]
  createdAt  DateTime          @default(now())
}

model RecurrenceMonth {
  id           String     @id @default(cuid())
  recurrence   Recurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  recurrenceId String
  month        Int // YYYYMM

  @@unique([recurrenceId, month])
  @@index([month])
}

model Movement {
  id         String   @id @default(cuid())
  name       String
  valueCents Int
  type       String
  owner      Person   @relation(fields: [ownerId], references: [id])
  ownerId    String
  month      Int // YYYYMM
  createdAt  DateTime @default(now())

  @@index([month])
}

model Settings {
  id               Int  @id @default(1)
  monthlyGoalCents Int?
}

// One OFX statement whose monthly totals were turned into movements. Free
// standing on purpose: nothing links a movement back to its import, because
// there is no undo — the row exists only so the same file cannot be imported
// twice. A relation here would also default to ON DELETE RESTRICT and start
// failing the movement/person delete handlers.
model OfxImport {
  id         String   @id @default(cuid())
  fileHash   String   @unique // hex SHA-256 of the uploaded bytes
  fileName   String
  importedAt DateTime @default(now())
}
