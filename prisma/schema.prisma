// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String
  createdAt DateTime   @default(now())
  forecasts Forecast[]
  movements Movement[]
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  targetCents Int
  createdAt   DateTime @default(now())
}

model Forecast {
  id         String          @id @default(cuid())
  name       String
  valueCents Int
  type       String
  owner      Person          @relation(fields: [ownerId], references: [id])
  ownerId    String
  // A what-if: registered exactly like any other forecast, but the dashboard
  // leaves it out unless the reader asks for it. Not a separate model — nothing
  // about it differs beyond this flag.
  simulated  Boolean         @default(false)
  // Label for the reader: already in the household's rhythm, or a future
  // obligation. Does not change the projection. Orthogonal to simulated.
  kind       String          @default("fixed")
  months     ForecastMonth[]
  createdAt  DateTime        @default(now())
}

model ForecastMonth {
  id         String   @id @default(cuid())
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  forecastId String
  month      Int // YYYYMM

  @@unique([forecastId, month])
  @@index([month])
}

model Movement {
  id         String   @id @default(cuid())
  name       String
  valueCents Int
  type       String
  owner      Person   @relation(fields: [ownerId], references: [id])
  ownerId    String
  month      Int // YYYYMM
  createdAt  DateTime @default(now())

  @@index([month])
}

// One OFX statement whose monthly totals were turned into movements. Free
// standing on purpose: nothing links a movement back to its import, because
// there is no undo — the row exists only so the same file cannot be imported
// twice. A relation here would also default to ON DELETE RESTRICT and start
// failing the movement/person delete handlers.
model OfxImport {
  id         String   @id @default(cuid())
  fileHash   String   @unique // hex SHA-256 of the uploaded bytes
  fileName   String
  importedAt DateTime @default(now())
}

// The monthly spending goal, back after 20260730120000_drop_settings removed it:
// that drop was right at the time — the field had no consumer — and this is what
// gives it one. The "Meta" target of the Teto de Gastos caps each month's budget
// at this value.
//
// A singleton, and only `monthlyGoalCents` this time. `rangeStart`/`rangeEnd`
// stay dead: the period is derived from the entries, never configured. The row
// is pinned to id 1 and only ever written by upsert (settings.prisma.repository),
// so there is no code path that creates a second one; the goal is family-wide,
// which is why it carries no ownerId.
model Settings {
  id               Int @id @default(1)
  monthlyGoalCents Int
}
