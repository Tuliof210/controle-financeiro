// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String
  createdAt DateTime   @default(now())
  forecasts Forecast[]
  movements Movement[]
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  targetCents Int
  createdAt   DateTime @default(now())
}

model Forecast {
  id         String          @id @default(cuid())
  name       String
  valueCents Int
  type       String
  owner      Person          @relation(fields: [ownerId], references: [id])
  ownerId    String
  months     ForecastMonth[]
  createdAt  DateTime        @default(now())
}

model ForecastMonth {
  id         String   @id @default(cuid())
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  forecastId String
  month      Int // YYYYMM

  @@unique([forecastId, month])
  @@index([month])
}

model Movement {
  id         String   @id @default(cuid())
  name       String
  valueCents Int
  type       String
  owner      Person   @relation(fields: [ownerId], references: [id])
  ownerId    String
  month      Int // YYYYMM
  createdAt  DateTime @default(now())

  @@index([month])
}

// One OFX statement whose monthly totals were turned into movements. Free
// standing on purpose: nothing links a movement back to its import, because
// there is no undo — the row exists only so the same file cannot be imported
// twice. A relation here would also default to ON DELETE RESTRICT and start
// failing the movement/person delete handlers.
model OfxImport {
  id         String   @id @default(cuid())
  fileHash   String   @unique // hex SHA-256 of the uploaded bytes
  fileName   String
  importedAt DateTime @default(now())
}
