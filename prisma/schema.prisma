// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String
  createdAt DateTime   @default(now())
  forecasts Forecast[]
  movements Movement[]
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  targetCents Int
  createdAt   DateTime @default(now())
}

model Forecast {
  id         String          @id @default(cuid())
  name       String
  valueCents Int
  type       String
  owner      Person          @relation(fields: [ownerId], references: [id])
  ownerId    String
  // A what-if: registered exactly like any other forecast, but the dashboard
  // leaves it out unless the reader asks for it. Not a separate model — nothing
  // about it differs beyond this flag.
  simulated  Boolean         @default(false)
  // Label for the reader: already in the household's rhythm, or a future
  // obligation. Does not change the projection. Orthogonal to simulated.
  kind       String          @default("fixed")
  months     ForecastMonth[]
  createdAt  DateTime        @default(now())
}

model ForecastMonth {
  id         String   @id @default(cuid())
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  forecastId String
  month      Int // YYYYMM

  @@unique([forecastId, month])
  @@index([month])
}

model Movement {
  id         String   @id @default(cuid())
  name       String
  valueCents Int
  type       String
  owner      Person   @relation(fields: [ownerId], references: [id])
  ownerId    String
  month      Int // YYYYMM
  createdAt  DateTime @default(now())

  @@index([month])
}

// One OFX statement whose monthly totals were turned into movements. Free
// standing on purpose: nothing links a movement back to its import, because
// there is no undo — the row exists only so the same file cannot be imported
// twice. A relation here would also default to ON DELETE RESTRICT and start
// failing the movement/person delete handlers.
model OfxImport {
  id         String   @id @default(cuid())
  fileHash   String   @unique // hex SHA-256 of the uploaded bytes
  fileName   String
  importedAt DateTime @default(now())
}

// Every adjustment the family makes to how the board reads itself: the ceiling
// (teto), the savings objectives, and whether simulated forecasts count.
//
// `monthlyGoalCents` was renamed to `ceilingCents` — the old name started to
// collide head-on with `goalsCents`, and what the column always held is the
// monthly ceiling in cents. The rename is an `ALTER TABLE … RENAME COLUMN` in
// 20260825112300_settings_ceiling_goals_simulated, never a table rebuild: a
// rebuild is what loses the row already saved in the owner's dev.db.
//
// The defaults reproduce today's behaviour exactly — 50 is DEFAULT_CEILING_CAP,
// 25 is the pace divisor, false is DEFAULT_SIMULATION_VIEW = "real". They are
// mirrored once more in src/lib/settings-defaults.ts, which is what a reader
// applies when get() answers null.
//
// A singleton. `rangeStart`/`rangeEnd` stay dead: the period is derived from the
// entries, never configured. The row is pinned to id 1 and only ever written by
// upsert (settings.prisma.repository), so there is no code path that creates a
// second one; the adjustments are family-wide, which is why the row carries no
// ownerId.
model Settings {
  id             Int     @id @default(1)
  ceilingCents   Int     @default(0)
  ceilingMode    String  @default("percent")
  ceilingPercent Int     @default(50)
  goalsMode      String  @default("percent")
  goalsPercent   Int     @default(25)
  goalsCents     Int     @default(0)
  showSimulated  Boolean @default(false)
}
